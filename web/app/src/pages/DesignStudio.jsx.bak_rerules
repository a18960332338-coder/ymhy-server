}
const DZ_ICON = { [BUCKET_MAIN]: <Icon name="home" size={16} />, [BUCKET_CAT]: <Icon name="cat" size={16} /> }
const DZ_COLOR = { [BUCKET_MAIN]: 'primary', [BUCKET_CAT]: 'default' }
const PB_PLACEHOLDER = (brand) => {
