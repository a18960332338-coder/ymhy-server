# ===== 云眠花园 · 运行环境变量示例 =====
# 用法: 把本文件复制一份重命名为 ".env"（放在 app.py 同目录），然后填下面的值。
# 注意: 不要把 .env 文件上传到 GitHub（已经帮你加了 .gitignore）。

# 【必填】NanoBanana API Key —— 合成主图、查积分用
# 获取: https://docs.nanobanana.ai/ 或你注册后的控制台
NANO_BANANA_API_KEY=在这里填你的key

# 【可选】本地服务监听端口，默认 8000
# APP_PORT=8000

# 【可选】本地服务监听地址: 127.0.0.1=仅自己用；0.0.0.0=同局域网朋友也能通过你的IP访问
# APP_HOST=127.0.0.1

# ===== 腾讯云 COS 对象存储配置（可选）=====
# 用于把图片/视频迁移到腾讯云 COS 桶，以及后续部署读远端数据用
# 获取密钥: 腾讯云控制台 -> 访问管理(CAM) -> API密钥管理 -> 新建密钥
COS_SECRET_ID=你的SecretId
COS_SECRET_KEY=你的SecretKey
COS_REGION=你的桶地区，例如 ap-hongkong
COS_BUCKET=你的桶名称，例如 ymhy-1309136992

# 设为 true 时后端优先从 COS 读写（默认 false=纯本地）
# USE_COS_STORAGE=false
